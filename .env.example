VITE_API_URL=
# Obbligatoria in produzione (Railway). Il valore sotto vale solo in locale con APP_ENV=development.
DATABASE_URL=postgresql+asyncpg://gcr:gcr_dev@localhost:5432/growth_control_room
# In produzione e' obbligatoria e non accetta "*": elenca gli origin del frontend.
CORS_ORIGINS=
APP_ENV=development

# Cifratura dei token di integrazione (obbligatoria in produzione).
# Generala con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Per ruotarla: metti la nuova chiave per prima, separata da virgola, poi ricifra e togli la vecchia.
SECRETS_ENCRYPTION_KEY=

# Account amministratore creato al primo avvio, se non esiste gia' un utente con password.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# OpenAI (proposte SEO — opzionale)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AI usage budgets and logging (optional)
AI_DAILY_BUDGET_USD=
AI_MONTHLY_BUDGET_USD=
AI_SINGLE_REQUEST_WARN_USD=
AI_SINGLE_REQUEST_BLOCK_USD=
AI_LOG_PROMPT_PREVIEW=false

# Shopify OAuth (servizio API)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# write_products serve per applicare le proposte SEO su prodotti e collection.
# Dopo averlo aggiunto qui e nell'app Shopify, riconnetti lo store: i token gia'
# emessi non ereditano i nuovi permessi.
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_content,write_content,read_reports,read_files,write_files
SHOPIFY_REDIRECT_URI=https://api-production-1077.up.railway.app/api/integrations/shopify/oauth/callback
FRONTEND_URL=https://web-production-77355.up.railway.app

# Editorial hero images (Content SEO)
EDITORIAL_IMAGE_STORAGE_PROVIDER=shopify_files
EDITORIAL_IMAGE_PUBLIC_BASE_URL=
EDITORIAL_IMAGE_S3_BUCKET=
EDITORIAL_IMAGE_S3_REGION=auto
EDITORIAL_IMAGE_S3_ACCESS_KEY=
EDITORIAL_IMAGE_S3_SECRET_KEY=
EDITORIAL_IMAGE_S3_ENDPOINT_URL=
PUBLIC_API_BASE_URL=
